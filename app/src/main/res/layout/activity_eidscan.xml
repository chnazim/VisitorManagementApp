<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    tools:context=".tab.activity.EIDScanActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan Emirates ID"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="16dp" />

        <!-- Top Two Dropdowns (Visitor Type, Visit Purpose) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visitor Type"
                    android:textColor="#CCCCCC"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerVisitorType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF" />
            </LinearLayout>

            <View
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visit Purpose"
                    android:textColor="#CCCCCC"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerVisitPurpose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Name Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editTextFullNameEnglish"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Full Name English"
                android:backgroundTint="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/editTextFullNameArabic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Full Name Arabic"
                android:backgroundTint="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- ID and Card Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editTextIdNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ID Number"
                android:backgroundTint="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/editTextCardNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Card Number"
                android:backgroundTint="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Mobile Number -->
        <EditText
            android:id="@+id/editTextMobileNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mobile Number"
            android:backgroundTint="#FFFFFF"
            android:textColorHint="#CCCCCC"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <!-- Profile Picture Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_launcher_background"
                android:scaleType="centerCrop"
                android:layout_alignParentStart="true" />

            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email ID"
                android:layout_toEndOf="@id/profileImageView"
                android:layout_marginStart="16dp"
                android:backgroundTint="#FFFFFF"
                android:textColorHint="#CCCCCC"
                android:textColor="#FFFFFF" />
        </RelativeLayout>

        <!-- Cancel and Check-In Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom">

            <Button
                android:id="@+id/buttonCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/buttonCheckIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Check-In"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF" />
        </LinearLayout>
        </LinearLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>